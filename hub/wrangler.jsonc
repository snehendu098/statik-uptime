{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "triggers": {
    "crons": ["*/1 * * * *"],  // Runs every minute, checks all websites based on their checkIntervals timestamp
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "statik-db",
      "database_id": "8c1e4969-4ed9-4752-8b9f-d668e017f3a2",
      "migrations_dir": "./src/db/migrations",
      "remote": true
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
