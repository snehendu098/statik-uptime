{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "triggers": {
    "crons": ["*/1 * * * *"],  // Runs every minute, checks all websites based on their checkIntervals timestamp
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "statik-db",
      "database_id": "c4cb55b2-aae7-4f14-b5de-a281ffae4c55",
      "migrations_dir": "./src/db/migrations",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VALIDATOR_REGISTRY",
        "class_name": "ValidatorRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ValidatorRegistry"]
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
